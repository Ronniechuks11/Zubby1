# Copy to your shell environment (or export these) before running. All optional.

# Client contact details used by the site
CONTACT_EMAIL=hello@valoradigital.example
WHATSAPP_NUMBER=2348000000000        # digits only, with country code

# Meta (Facebook/Instagram) Pixel. Leave empty to disable tracking.
META_PIXEL_ID=

# Preview builds are hidden from search engines. Set to 1 once the client approves.
ALLOW_INDEXING=0

# Dev server
HOST=127.0.0.1
PORT=5000
FLASK_DEBUG=1

# Set to 1 when deployed behind a reverse proxy (nginx, Render, Railway...)
TRUST_PROXY=0
